{
  "manifest_version": 3,
  "name": "AIS Connector",
  "version": "1.0.0",
  "description": "在侧边栏管理 AIStudio 用户、认证和 SSH 隧道",
  "permissions": ["storage", "sidePanel", "nativeMessaging"],
  "action": {"default_title": "打开 AIS Connector", "default_icon": {"16":"assets/icon-16.png","32":"assets/icon-32.png"}},
  "icons": {"16":"assets/icon-16.png","32":"assets/icon-32.png","48":"assets/icon-48.png","128":"assets/icon-128.png"},
  "background": {"service_worker": "background.js"},
  "side_panel": {"default_path": "panel.html"},
  "minimum_chrome_version": "116"
}
